---
import BaseLayout from '../layouts/BaseLayout.astro'
import Catalog from '../components/Catalog.astro'
import { getFilms } from '../lib/ghibli';

const films = await getFilms()
---

<BaseLayout>
    <div class="container">
        <section class="hero">
            <p lang="ja">株式会社スタジオジブリ</p>
            <h1>Studio Ghibli Inc.</h1>
            <p class="description">Japanese animation studio based in Koganei, Tokyo.</p>
        </section>
    </div>
    <Catalog films={films} />
</BaseLayout>
